# NetMon environment variables
# Copy to .env and adjust. Every value here can also live in config.yaml,
# but environment variables always win (env-first resolution order).

# ---------------------------------------------------------------------------
# Ollama (local LLM used for AI-assisted diagnostics)
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TIMEOUT=30

# ---------------------------------------------------------------------------
# InfluxDB (time-series metrics). INFLUX_TOKEN is required for metric writes;
# when it is unset NetMon degrades gracefully to in-memory state only.
# ---------------------------------------------------------------------------
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=netmon
INFLUXDB_BUCKET=metrics

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite database holding config, diagnostic history and alert rules.
NETMON_SQLITE_PATH=~/.config/netmon/config.db
# YAML configuration file synced into SQLite on first run.
NETMON_CONFIG_PATH=~/.config/netmon/config.yaml

# ---------------------------------------------------------------------------
# Web interface
# ---------------------------------------------------------------------------
NETMON_WEB_HOST=0.0.0.0
NETMON_WEB_PORT=8080
# HTTP Basic auth (optional). Set a strong password, then uncomment all three
# lines or enable web.auth in config.yaml. Environment values win over YAML.
# NETMON_WEB_AUTH=true
# NETMON_WEB_USERNAME=admin
# NETMON_WEB_PASSWORD=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NETMON_ENV=development
NETMON_DEBUG=false
NETMON_LOG_LEVEL=INFO
